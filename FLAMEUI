local TweenService = game:GetService("TweenService")

function FlameUI:Notify(config)
    config = config or {}

    local ScreenGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

    local Holder = ScreenGui:FindFirstChild("FlameUI_Notifications")
    if not Holder then
        Holder = Instance.new("ScreenGui")
        Holder.Name = "FlameUI_Notifications"
        Holder.ResetOnSpawn = false
        Holder.Parent = ScreenGui
    end

    local Notification = Instance.new("Frame")
    Notification.Size = UDim2.new(0, 250, 0, 60)
    Notification.Position = UDim2.new(1, 20, 0, 20)
    Notification.BackgroundColor3 = self.Theme.Topbar
    Notification.Parent = Holder

    Instance.new("UICorner", Notification).CornerRadius = UDim.new(0, 8)

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -10, 0, 25)
    Title.Position = UDim2.new(0, 5, 0, 5)
    Title.BackgroundTransparency = 1
    Title.Text = config.Title or "FlameUI"
    Title.TextColor3 = self.Theme.Text
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 14
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Notification

    local Desc = Instance.new("TextLabel")
    Desc.Size = UDim2.new(1, -10, 0, 25)
    Desc.Position = UDim2.new(0, 5, 0, 30)
    Desc.BackgroundTransparency = 1
    Desc.Text = config.Text or "Notification"
    Desc.TextColor3 = self.Theme.SecondaryText
    Desc.Font = Enum.Font.Gotham
    Desc.TextSize = 12
    Desc.TextXAlignment = Enum.TextXAlignment.Left
    Desc.Parent = Notification

    -- Slide in animation
    Notification.Position = UDim2.new(1, 300, 0, 20)

    TweenService:Create(
        Notification,
        TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        {Position = UDim2.new(1, -270, 0, 20)}
    ):Play()

    task.delay(config.Duration or 3, function()
        TweenService:Create(
            Notification,
            TweenInfo.new(0.4),
            {Position = UDim2.new(1, 300, 0, 20)}
        ):Play()

        task.wait(0.5)
        Notification:Destroy()
    end)
end
--// SECTION 9B - Config System

FlameUI.Config = {}

local HttpService = game:GetService("HttpService")

function FlameUI:SaveConfig(name, data)
    if writefile then
        local encoded = HttpService:JSONEncode(data)
        writefile("FlameUI/" .. name .. ".json", encoded)
    end
end

function FlameUI:LoadConfig(name)
    if readfile and isfile and isfile("FlameUI/" .. name .. ".json") then
        local raw = readfile("FlameUI/" .. name .. ".json")
        return HttpService:JSONDecode(raw)
    end
    return nil
end

function FlameUI:InitConfigFolder()
    if makefolder and not isfolder("FlameUI") then
        makefolder("FlameUI")
    end
end
--// SECTION 10A - Theme System Core

FlameUI.Theme = {
    Background = Color3.fromRGB(20, 20, 25),
    Topbar = Color3.fromRGB(25, 25, 30),
    Sidebar = Color3.fromRGB(18, 18, 22),
    Accent = Color3.fromRGB(120, 80, 255),
    Text = Color3.fromRGB(240, 240, 240),
    SubText = Color3.fromRGB(170, 170, 170),
    Stroke = Color3.fromRGB(60, 60, 70)
}

FlameUI.ThemeObjects = {}

function FlameUI:RegisterThemeObject(obj, property, key)
    if not self.ThemeObjects[key] then
        self.ThemeObjects[key] = {}
    end

    table.insert(self.ThemeObjects[key], {
        Object = obj,
        Property = property
    })

    -- apply instantly
    obj[property] = self.Theme[key]
end
function FlameUI:SetTheme(newTheme)
    for k, v in pairs(newTheme) do
        self.Theme[k] = v
    end

    -- update all registered objects
    for key, objects in pairs(self.ThemeObjects) do
        for _, data in ipairs(objects) do
            if data.Object and data.Object.Parent then
                data.Object[data.Property] = self.Theme[key]
            end
        end
    end
end
