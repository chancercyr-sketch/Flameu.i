function Window:CreateTab(Settings)
    Settings = Settings or {}

    local TabName = Settings.Name or "Tab"

    local Tab = {}
    Tab.__index = Tab

    -- Tab Button

    local TabButton = Create("TextButton",{
        Name = TabName,
        Size = UDim2.new(1,-10,0,35),
        Position = UDim2.new(0,5,0,0),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = TabName,
        Font = Enum.Font.GothamSemibold,
        TextSize = 14,
        TextColor3 = Theme.Text,
        Parent = self.TabButtons
    })

    Create("UICorner",{
        CornerRadius = UDim.new(0,8),
        Parent = TabButton
    })

    -- Page

    local Page = Create("ScrollingFrame",{
        Name = TabName.."Page",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(180,50),
        Size = UDim2.new(1,-190,1,-60),
        CanvasSize = UDim2.new(),
        ScrollBarThickness = 3,
        Visible = false,
        Parent = self.Main
    })

    local Layout = Create("UIListLayout",{
        Padding = UDim.new(0,8),
        Parent = Page
    })

    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.fromOffset(
            0,
            Layout.AbsoluteContentSize.Y + 15
        )
    end)

    -- First Tab Logic

    local ExistingPages = {}

    for _,v in pairs(self.Main:GetChildren()) do
        if v:IsA("ScrollingFrame") then
            table.insert(ExistingPages,v)
        end
    end

    if #ExistingPages == 1 then
        Page.Visible = true
        TabButton.BackgroundColor3 = Theme.Accent
    end

    -- Switching

    TabButton.MouseButton1Click:Connect(function()

        for _,Obj in pairs(self.Main:GetChildren()) do
            if Obj:IsA("ScrollingFrame") then
                Obj.Visible = false
            end
        end

        for _,Button in pairs(self.TabButtons:GetChildren()) do
            if Button:IsA("TextButton") then
                Tween(Button,{
                    BackgroundColor3 = Theme.Background
                },0.2):Play()
            end
        end

        Page.Visible = true

        Tween(TabButton,{
            BackgroundColor3 = Theme.Accent
        },0.2):Play()

    end)

    -- Hover Animations

    TabButton.MouseEnter:Connect(function()
        if not Page.Visible then
            Tween(TabButton,{
                BackgroundColor3 = Color3.fromRGB(35,35,35)
            },0.15):Play()
        end
    end)

    TabButton.MouseLeave:Connect(function()
        if not Page.Visible then
            Tween(TabButton,{
                BackgroundColor3 = Theme.Background
            },0.15):Play()
        end
    end)

    Tab.Page = Page

    return setmetatable(Tab, Tab)
end
