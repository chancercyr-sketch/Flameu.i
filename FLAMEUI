function FlameUI:ApplyPreset(name)
    local preset = self.Presets[name]
    if preset then
        self:SetTheme(preset)
    end
end
--// SECTION 11A - UI Polish Animations

local TweenService = game:GetService("TweenService")

function FlameUI:ApplyHoverEffect(button)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {
            BackgroundTransparency = 0.2
        }):Play()
    end)

    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {
            BackgroundTransparency = 0.4
        }):Play()
    end)
end

function FlameUI:ClickBounce(button)
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.1), {
            Size = UDim2.new(button.Size.X.Scale, button.Size.X.Offset - 2,
                             button.Size.Y.Scale, button.Size.Y.Offset - 2)
        }):Play()
    end)

    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.1), {
            Size = UDim2.new(button.Size.X.Scale, button.Size.X.Offset + 2,
                             button.Size.Y.Scale, button.Size.Y.Offset + 2)
        }):Play()
    end)
end
function FlameUI:FadeIn(frame)
    frame.BackgroundTransparency = 1

    TweenService:Create(frame, TweenInfo.new(0.35), {
        BackgroundTransparency = 0
    }):Play()

    for _, v in ipairs(frame:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextButton") then
            v.TextTransparency = 1
            TweenService:Create(v, TweenInfo.new(0.35), {
                TextTransparency = 0
            }):Play()
        end
    end
end
function FlameUI:EnableMinimize(window)
    local topbar = window.Topbar
    local frame = window.Instance

    local minimized = false

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 30, 0, 30)
    button.Position = UDim2.new(1, -70, 0, 5)
    button.BackgroundColor3 = self.Theme.Topbar
    button.Text = "-"
    button.TextColor3 = self.Theme.Text
    button.Parent = topbar

    button.MouseButton1Click:Connect(function()
        minimized = not minimized

        if minimized then
            TweenService:Create(frame, TweenInfo.new(0.25), {
                Size = UDim2.new(0, 600, 0, 40)
            }):Play()
        else
            TweenService:Create(frame, TweenInfo.new(0.25), {
                Size = UDim2.new(0, 600, 0, 400)
            }):Play()
        end
    end)
end
function FlameUI:EnableClose(window)
    local topbar = window.Topbar
    local frame = window.Instance

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 30, 0, 30)
    button.Position = UDim2.new(1, -35, 0, 5)
    button.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    button.Text = "X"
    button.TextColor3 = Color3.fromRGB(255,255,255)
    button.Parent = topbar

    button.MouseButton1Click:Connect(function()
        TweenService:Create(frame, TweenInfo.new(0.2), {
            BackgroundTransparency = 1
        }):Play()

        task.wait(0.2)
        frame:Destroy()
    end)
end
function FlameUI:CreateWatermark(text)
    local ScreenGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

    local wm = Instance.new("TextLabel")
    wm.Size = UDim2.new(0, 200, 0, 25)
    wm.Position = UDim2.new(1, -210, 1, -30)
    wm.BackgroundTransparency = 0.4
    wm.BackgroundColor3 = self.Theme.Topbar
    wm.Text = text or "FlameUI"
    wm.TextColor3 = self.Theme.Text
    wm.Font = Enum.Font.GothamBold
    wm.TextSize = 12
    wm.Parent = ScreenGui

    Instance.new("UICorner", wm).CornerRadius = UDim.new(0, 6)
end
function FlameUI:CreateLoader(text, duration)
    local ScreenGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

    local loader = Instance.new("Frame")
    loader.Size = UDim2.new(1,0,1,0)
    loader.BackgroundColor3 = Color3.fromRGB(0,0,0)
    loader.Parent = ScreenGui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1,0,1,0)
    label.BackgroundTransparency = 1
    label.Text = text or "FlameUI Loading..."
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 18
    label.Parent = loader

    TweenService:Create(loader, TweenInfo.new(duration or 1), {
        BackgroundTransparency = 1
    }):Play()

    task.wait(duration or 1)
    loader:Destroy()
end
--// FINAL SECTION - Library Return + Loaded Signal

FlameUI.Loaded = false

function FlameUI:Init()
    self.Loaded = true

    -- optional loaded print
    print("[FlameUI] Successfully loaded!")

    -- optional global signal (useful for scripts waiting on UI)
    if _G then
        _G.FlameUILoaded = true
    end
end

-- auto-init when required
task.spawn(function()
    FlameUI:Init()
end)

return FlameUI
