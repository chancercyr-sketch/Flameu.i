function FlameUI:Window(cfg)
    cfg = cfg or {}
    local T = Themes[cfg.Theme or "Dark"] or Themes.Dark
    local W = (cfg.Size and cfg.Size.X.Offset) or 620
    local H = (cfg.Size and cfg.Size.Y.Offset) or 480
    local SW = 160

    local Wrap = child(Screen, "Frame", {AnchorPoint = Vector2.new(0.5,0.5), Size = UDim2.new(0, W+48, 0, H+48), Position = UDim2.new(0.5,0,0.5,0), BackgroundTransparency = 1})
    child(Wrap, "ImageLabel", {AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.new(0.5,0,0.5,6), Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Image = "rbxassetid://6014261993", ImageColor3 = Color3.new(0,0,0), ImageTransparency = 0.35, ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49,49,450,450)})

    local Root = child(Wrap, "Frame", {AnchorPoint = Vector2.new(0.5,0.5), Size = UDim2.new(0,W,0,0), Position = UDim2.new(0.5,0,0.5,0), BackgroundColor3 = H(T.Win), BorderSizePixel = 0, ClipsDescendants = true})
    corner(Root, 16)
    stroke(Root, H(T.Bord), 1.5)
    Root.BackgroundTransparency = 0

    task.defer(function() tw(Root, {Size = UDim2.new(0,W,0,H)}, 0.5, Enum.EasingStyle.Back) end)

    local TopH = 52
    local Bar = child(Root, "Frame", {Size = UDim2.new(1,0,0,TopH), BackgroundColor3 = H(T.Bar), ZIndex = 10})
    corner(Bar, 16)
    gradient(Bar, H(T.Gradient1), H(T.Gradient2))

    child(Bar, "TextLabel", {Text="🔥", Font=Enum.Font.GothamBold, TextSize=20, TextColor3=H(T.Acc), Size=UDim2.new(0,36,1,0), Position=UDim2.new(0,14,0,0), BackgroundTransparency=1, ZIndex=12})
    child(Bar, "TextLabel", {Text=cfg.Title or "FlameUI Ultimate", Font=Enum.Font.GothamBold, TextSize=15, TextColor3=H(T.Txt), Size=UDim2.new(1,-160,1,0), Position=UDim2.new(0,58,0,0), TextXAlignment=Enum.TextXAlignment.Left, BackgroundTransparency=1, ZIndex=12})

    if cfg.Author then
        child(Bar, "TextLabel", {Text="by "..cfg.Author, Font=Enum.Font.Gotham, TextSize=12, TextColor3=H(T.Sub), Size=UDim2.new(1,-20,1,0), Position=UDim2.new(0,10,0,0), TextXAlignment=Enum.TextXAlignment.Right, BackgroundTransparency=1, ZIndex=12})
    end

    local function ctrlBtn(x, lbl, col)
        local b = child(Bar, "TextButton", {Text=lbl, Font=Enum.Font.GothamBold, TextSize=14, TextColor3=H(col), BackgroundColor3=H(T.El), Size=UDim2.new(0,26,0,26), Position=UDim2.new(1,x,0.5,-13), AutoButtonColor=false, ZIndex=15})
        corner(b,8)
        conn(b.MouseEnter, function() tw(b, {BackgroundColor3=H(col), TextColor3=H("#ffffff")}, 0.1) end)
        conn(b.MouseLeave, function() tw(b, {BackgroundColor3=H(T.El), TextColor3=H(col)}, 0.1) end)
        return b
    end

    local CloseBtn = ctrlBtn(-34, "✕", T.Close)
    local MinBtn = ctrlBtn(-68, "−", T.Min)

    conn(CloseBtn.MouseButton1Click, function()
        tw(Root, {Size=UDim2.new(0,W,0,0)}, 0.3)
        task.delay(0.35, function() Wrap:Destroy() end)
    end)

    local minimized = false
    conn(MinBtn.MouseButton1Click, function()
        minimized = not minimized
        tw(Root, {Size = minimized and UDim2.new(0,W,0,TopH) or UDim2.new(0,W,0,H)}, 0.35)
    end)

    if cfg.Draggable ~= false then
        local drag, ds, dp = false
        conn(Bar.InputBegan, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                drag = true; ds = i.Position; dp = Wrap.Position
            end
        end)
        conn(UserInputService.InputChanged, function(i)
            if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = i.Position - ds
                Wrap.Position = UDim2.new(dp.X.Scale, dp.X.Offset + delta.X, dp.Y.Scale, dp.Y.Offset + delta.Y)
            end
        end)
        conn(UserInputService.InputEnded, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
        end)
    end

    local Body = child(Root, "Frame", {Size=UDim2.new(1,0,1,-TopH), Position=UDim2.new(0,0,0,TopH), BackgroundTransparency=1, ClipsDescendants=true})
    local Sidebar = child(Body, "Frame", {Size=UDim2.new(0,SW,1,0), BackgroundColor3=H(T.Side)})
    child(Sidebar, "Frame", {Size=UDim2.new(0,1,1,0), Position=UDim2.new(1,-1,0,0), BackgroundColor3=H(T.Bord)})
    child(Sidebar, "TextLabel", {Text="🔥 FlameUI", Font=Enum.Font.GothamBold, TextSize=10, TextColor3=H(T.SecTxt), Size=UDim2.new(1,0,0,24), Position=UDim2.new(0,0,1,-24), TextXAlignment=Enum.TextXAlignment.Center, BackgroundTransparency=1})

    local TabScroll = child(Sidebar, "ScrollingFrame", {Size=UDim2.new(1,0,1,-24), BackgroundTransparency=1, ScrollBarThickness=0, AutomaticCanvasSize=Enum.AutomaticSize.Y})
    pad(TabScroll,8,8,8,8); list(TabScroll)

    local ContentArea = child(Body, "Frame", {Size=UDim2.new(1,-SW,1,0), Position=UDim2.new(0,SW,0,0), BackgroundColor3=H(T.Panel), ClipsDescendants=true})

    local Win = {_T = T, _tabs = {}, _active = nil}

    function Win:_select(tab)
        if self._active then
            tw(self._active._btn, {BackgroundColor3 = H(T.Side), TextColor3 = H(T.Sub)}, 0.15)
            self._active._indicator.Visible = false
            self._active._scroll.Visible = false
        end
        self._active = tab
        tw(tab._btn, {BackgroundColor3 = H(T.El), TextColor3 = H(T.Txt)}, 0.15)
        tab._indicator.Visible = true
        tab._scroll.Visible = true
    end
    function Win:Tab(cfg)
        cfg = cfg or {}
        local icon = cfg.Icon or ""
        local lbl = (icon ~= "" and icon .. "  " or "") .. (cfg.Title or "Tab")

        local Btn = child(TabScroll, "TextButton", {Text = lbl, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = H(T.Sub), BackgroundColor3 = H(T.Side), Size = UDim2.new(1,0,0,36), TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false})
        corner(Btn,8); pad(Btn,0,12,0,12)

        local Ind = child(Btn, "Frame", {Size = UDim2.new(0,3,0.65,0), Position = UDim2.new(0,0,0.175,0), BackgroundColor3 = H(T.Acc), Visible = false})
        corner(Ind,2)

        local Scroll = child(ContentArea, "ScrollingFrame", {Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, ScrollBarThickness = 3, ScrollBarImageColor3 = H(T.Bord), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false})
        pad(Scroll,12,14,12,14); list(Scroll)

        local tab = {_btn = Btn, _indicator = Ind, _scroll = Scroll, _T = T}

        conn(Btn.MouseButton1Click, function() Win:_select(tab) end)
        conn(Btn.MouseEnter, function() if Win._active ~= tab then tw(Btn, {BackgroundColor3 = H(T.El), TextColor3 = H(T.Txt)}, 0.12) end end)
        conn(Btn.MouseLeave, function() if Win._active ~= tab then tw(Btn, {BackgroundColor3 = H(T.Side), TextColor3 = H(T.Sub)}, 0.12) end end)

        table.insert(self._tabs, tab)
        if #self._tabs == 1 then Win:_select(tab) end

        local function Card(h)
            local f = child(Scroll, "Frame", {Size = UDim2.new(1,0,0,h or 52), BackgroundColor3 = H(T.El)})
            corner(f,12)
            gradient(f, H(T.Gradient1 or T.El), H(T.Gradient2 or T.El))
            return f
        end

        local function Titl(p, txt, y)
            return child(p, "TextLabel", {Text = txt or "", Font = Enum.Font.GothamSemibold, TextSize = 13, TextColor3 = H(T.Txt), Size = UDim2.new(1,-16,0,16), Position = UDim2.new(0,14,0,y or 8), TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1})
        end

        local function Subt(p, txt, y)
            if not txt or txt == "" then return end
            child(p, "TextLabel", {Text = txt, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = H(T.Sub), Size = UDim2.new(1,-16,0,13), Position = UDim2.new(0,14,0,y or 26), TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1})
        end

        local function Hov(f)
            conn(f.MouseEnter, function() tw(f, {BackgroundColor3 = H(T.ElHov)}, 0.12) end)
            conn(f.MouseLeave, function() tw(f, {BackgroundColor3 = H(T.El)}, 0.12) end)
        end

        function tab:Toggle(cfg)
            cfg = cfg or {}
            local val = cfg.Value or false
            local cb = cfg.Callback or function() end
            local f = Card(cfg.Desc and 56 or 46); Hov(f)
            Titl(f, cfg.Title, cfg.Desc and 11 or 15); Subt(f, cfg.Desc, 28)

            local Track = child(f, "Frame", {Size = UDim2.new(0,42,0,22), Position = UDim2.new(1,-54,0.5,-11), BackgroundColor3 = H(val and T.TgOn or T.TgOff)})
            corner(Track,11)
            local Knob = child(Track, "Frame", {Size = UDim2.new(0,16,0,16), Position = val and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8), BackgroundColor3 = H(T.TgKnob)})
            corner(Knob,8)

            local Hit = child(f, "TextButton", {Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Text = ""})
            local obj = {Value = val}
            function obj:Set(v, fire)
                obj.Value = v
                tw(Track, {BackgroundColor3 = H(v and T.TgOn or T.TgOff)}, 0.2)
                tw(Knob, {Position = v and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)}, 0.2)
                if fire ~= false then pcall(cb, v) end
            end
            conn(Hit.MouseButton1Click, function() obj:Set(not obj.Value) end)
            return obj
        end

        function tab:Slider(cfg)
            cfg = cfg or {}
            local mn, mx = cfg.Min or 0, cfg.Max or 100
            local val = math.clamp(cfg.Value or mn, mn, mx)
            local dp = cfg.Rounding or 0
            local cb = cfg.Callback or function() end
            local f = Card(cfg.Desc and 64 or 54); Hov(f)
            Titl(f, cfg.Title, 9); Subt(f, cfg.Desc, 25)
            local yy = cfg.Desc and 44 or 36

            local VL = child(f, "TextLabel", {Text = tostring(val), Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = H(T.Acc), Size = UDim2.new(0,54,0,14), Position = UDim2.new(1,-66,0,8), TextXAlignment = Enum.TextXAlignment.Right, BackgroundTransparency = 1})

            local TrBg = child(f, "Frame", {Size = UDim2.new(1,-28,0,4), Position = UDim2.new(0,14,0,yy+2), BackgroundColor3 = H(T.SlTr)})
            corner(TrBg,2)

            local pct = (val - mn) / (mx - mn)
            local Fill = child(TrBg, "Frame", {Size = UDim2.new(pct,0,1,0), BackgroundColor3 = H(T.SlFi)})
            corner(Fill,2)

            local Knob = child(TrBg, "Frame", {Size = UDim2.new(0,14,0,14), Position = UDim2.new(pct,-7,0.5,-7), BackgroundColor3 = H(T.SlKn)})
            corner(Knob,7)
            child(Knob, "UIStroke", {Color = H(T.SlFi), Thickness = 2})

            local TrHit = child(f, "TextButton", {Size = UDim2.new(1,-28,0,20), Position = UDim2.new(0,14,0,yy-6), BackgroundTransparency = 1, Text = ""})

            local obj = {Value = val}; local drag = false

            local function upd(x)
                local r = math.clamp((x - TrBg.AbsolutePosition.X) / TrBg.AbsoluteSize.X, 0, 1)
                local v = math.round((mn + r * (mx - mn)) * (10^dp)) / (10^dp)
                v = math.clamp(v, mn, mx)
                obj.Value = v
                local np = (v - mn) / (mx - mn)
                Fill.Size = UDim2.new(np,0,1,0)
                Knob.Position = UDim2.new(np,-7,0.5,-7)
                VL.Text = tostring(v)
                pcall(cb, v)
            end

            conn(TrHit.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true; upd(i.Position.X) end end)
            conn(UserInputService.InputChanged, function(i) if drag and i.UserInputType == Enum.UserInputType.MouseMovement then upd(i.Position.X) end end)
            conn(UserInputService.InputEnded, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)

